# Getting and Cleaning Data Course Project
# run_analysis.R

# Install dplyr if it is not already installed
if (!requireNamespace("dplyr", quietly = TRUE)) {
  install.packages("dplyr")
}
library(dplyr)

# 1. Download and unzip the dataset
url <- paste0(
  "https://d396qusza40orc.cloudfront.net/getdata/",
  "projectfiles/UCI%20HAR%20Dataset.zip"
)

zip_file <- "UCI_HAR_Dataset.zip"
data_dir <- "data"

if (!dir.exists(data_dir)) {
  dir.create(data_dir)
}

if (!file.exists(zip_file)) {
  download.file(url, zip_file, mode = "wb")
}

dataset_dir <- file.path(data_dir, "UCI HAR Dataset")

if (!dir.exists(dataset_dir)) {
  unzip(zip_file, exdir = data_dir)
}

# 2. Read the activity labels and feature names
activity_labels <- read.table(
  file.path(dataset_dir, "activity_labels.txt"),
  col.names = c("activity_id", "activity")
)

features <- read.table(
  file.path(dataset_dir, "features.txt"),
  col.names = c("index", "feature")
)

# Select only mean and standard deviation measurements
selected_features <- grepl(
  "mean\\(\\)|std\\(\\)",
  features$feature
)

measurement_names <- features$feature[selected_features]

# Make variable names more descriptive and readable
measurement_names <- gsub("^t", "time_", measurement_names)
measurement_names <- gsub("^f", "frequency_", measurement_names)
measurement_names <- gsub("Acc", "Accelerometer", measurement_names)
measurement_names <- gsub("Gyro", "Gyroscope", measurement_names)
measurement_names <- gsub("Mag", "Magnitude", measurement_names)
measurement_names <- gsub("\\(\\)", "", measurement_names)
measurement_names <- gsub("[^A-Za-z0-9]+", "_", measurement_names)
measurement_names <- gsub("_+$", "", measurement_names)
measurement_names <- make.unique(measurement_names)

# 3. Read the training data
train_x <- read.table(
  file.path(dataset_dir, "train", "X_train.txt")
)

train_y <- read.table(
  file.path(dataset_dir, "train", "y_train.txt"),
  col.names = "activity_id"
)

train_subject <- read.table(
  file.path(dataset_dir, "train", "subject_train.txt"),
  col.names = "subject"
)

# 4. Read the test data
test_x <- read.table(
  file.path(dataset_dir, "test", "X_test.txt")
)

test_y <- read.table(
  file.path(dataset_dir, "test", "y_test.txt"),
  col.names = "activity_id"
)

test_subject <- read.table(
  file.path(dataset_dir, "test", "subject_test.txt"),
  col.names = "subject"
)

# 5. Merge the training and test datasets
x_data <- rbind(train_x, test_x)
y_data <- rbind(train_y, test_y)
subject_data <- rbind(train_subject, test_subject)

# 6. Extract only the selected mean and standard deviation columns
tidy_data <- x_data[, selected_features]
names(tidy_data) <- measurement_names

# 7. Add subject and descriptive activity names
tidy_data$subject <- subject_data$subject
tidy_data$activity_id <- y_data$activity_id

tidy_data <- merge(
  tidy_data,
  activity_labels,
  by = "activity_id",
  sort = FALSE
)

# 8. Arrange the data by subject and activity
tidy_data <- tidy_data %>%
  select(-activity_id) %>%
  select(subject, activity, everything()) %>%
  arrange(subject, activity)

# 9. Create a second tidy dataset with averages
average_data <- tidy_data %>%
  group_by(subject, activity) %>%
  summarise(
    across(where(is.numeric), ~ mean(.x)),
    .groups = "drop"
  ) %>%
  arrange(subject, activity)

# 10. Write the final tidy dataset
write.table(
  average_data,
  "tidy_data.txt",
  row.names = FALSE,
  quote = FALSE
)

# Optional: save the merged dataset before averaging
write.table(
  tidy_data,
  "tidy_data_all_measurements.txt",
  row.names = FALSE,
  quote = FALSE
)

cat("Analysis complete!\n")
cat("Final dataset: tidy_data.txt\n")
cat("Rows:", nrow(average_data), "\n")
cat("Columns:", ncol(average_data), "\n")